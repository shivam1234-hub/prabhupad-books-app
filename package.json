{
  "name": "prabhupad-books-app",
  "version": "1.10.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~56.0.15",
    "@shopify/flash-list": "^2.3.2",
    "@tanstack/react-query": "^5.101.0",
    "axios": "^1.17.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "^56.0.15",
    "date-fns": "^4.4.0",
    "download-service": "file:./modules/download-service",
    "expo": "~56.0.11",
    "expo-asset": "56.0.17",
    "expo-av": "^16.0.9-canary-20260119-17896bf",
    "expo-background-fetch": "~56.0.18",
    "expo-constants": "~56.0.18",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.6",
    "expo-haptics": "~56.0.3",
    "expo-intent-launcher": "~56.0.4",
    "expo-linking": "~56.0.14",
    "expo-media-library": "~56.0.7",
    "expo-notifications": "~56.0.17",
    "expo-router": "~56.2.10",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.17",
    "expo-splash-screen": "~56.0.10",
    "expo-sqlite": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-task-manager": "~56.0.18",
    "expo-web-browser": "~56.0.5",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.1.0",
    "node-sqlite3-wasm": "0.8.60",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "^15.15.5",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "^0.8.3",
    "wallpaper-setter": "file:./modules/wallpaper-setter",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "concurrently": "^10.0.3",
    "electron": "44.4.4",
    "electron-builder": "26.15.3",
    "typescript": "~6.0.3",
    "wait-on": "9.1.0"
  },
  "scripts": {
    "android": "expo run:android",
    "desktop": "npm run desktop:bundle && electron desktop/main.js",
    "desktop:bundle": "expo export --platform web --output-dir dist-desktop --clear",
    "desktop:dev": "concurrently -n metro,electron -c cyan,magenta \"expo start --web --port 8081\" \"wait-on http://localhost:8081 && VEDABASE_DEV_URL=http://localhost:8081 electron desktop/main.js\"",
    "desktop:linux": "npm run desktop:bundle && electron-builder --linux",
    "desktop:mac": "npm run desktop:bundle && electron-builder --mac",
    "desktop:start": "electron desktop/main.js",
    "desktop:win": "npm run desktop:bundle && electron-builder --win",
    "ios": "expo run:ios",
    "proxy": "node cors-proxy.js",
    "start": "expo start",
    "test:books": "node --no-warnings scripts/test-books.mts",
    "test:search": "node --no-warnings --import ./scripts/ts-node-loader.mjs scripts/test-search.mts",
    "web": "expo start --web",
    "web:dev": "concurrently -n proxy,expo -c cyan,yellow \"node cors-proxy.js\" \"expo start --web --port 8081\""
  },
  "private": true
}
