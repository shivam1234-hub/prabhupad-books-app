# expo-av is pinned to a canary build whose peer range names a different expo
# version than the one this project uses, so npm's strict peer resolution fails.
# The tree it produces is the one the app has always run on — make that explicit
# and reproducible here rather than relying on everyone remembering the flag
# (CI needs it too: .github/workflows/desktop-windows.yml).
legacy-peer-deps=true
